<?xml version="1.0" encoding="utf-8"?>
<!-- RustGIS on Android, the phase 0 spike (#1902): a NativeActivity that loads librustgis_mobile.so.
     There is no Java or Kotlin of ours (android:hasCode="false"). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.rustgis.mobile"
    android:versionCode="1"
    android:versionName="0.0.0-spike">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- Basemap tiles and web layers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="RustGIS"
        android:hasCode="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- configChanges: a rotation or a resize reaches the running app instead of restarting it. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection|navigation">
            <meta-data android:name="android.app.lib_name" android:value="rustgis_mobile" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
